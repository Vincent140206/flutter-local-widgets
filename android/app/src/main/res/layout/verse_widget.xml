<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:padding="18dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="TODAY'S VERSE" android:textSize="10sp"
        android:letterSpacing="0.12" android:textColor="#BBAFFF" />
    <TextView android:id="@+id/verse_text" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:maxLines="4" android:ellipsize="end" android:textSize="17sp"
        android:textColor="#FFFFFF" />
    <TextView android:id="@+id/verse_reference" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:textSize="12sp" android:textColor="#BBAFFF" />
</LinearLayout>
