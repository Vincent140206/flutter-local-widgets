<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="18dp"
    android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="WATCHLIST" android:textSize="11sp" android:textColor="#BBAFFF"
        android:letterSpacing="0.12" />
    <TextView android:id="@+id/watch_items" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:textSize="15sp" android:lineSpacingExtra="8dp"
        android:maxLines="4" android:ellipsize="end" android:textColor="#FFFFFF" />
</LinearLayout>
