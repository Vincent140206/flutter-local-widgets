<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/whatsapp_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/whatsapp_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WHATSAPP"
            android:textColor="#DDF6E8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/whatsapp_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/whatsapp_badge_background"
            android:text="0 notifications"
            android:textColor="#68D391"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5dp">

        <ListView
            android:id="@+id/whatsapp_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/whatsapp_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="No saved WhatsApp notifications"
            android:textColor="#8F9993"
            android:textSize="12sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/whatsapp_open"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="end|center_vertical"
        android:text="Open WhatsApp  →"
        android:textColor="#68D391"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
